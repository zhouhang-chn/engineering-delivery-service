# Template for the EDS runtime environment. Copy to `.env` (gitignored)
# and fill in real values — the application loads it itself at startup
# (python-dotenv), so nothing needs to be exported in the shell.
# Already-exported environment variables always take precedence.

# PostgreSQL connection for durable Work Order state
EDS_DATABASE_URL=postgresql+psycopg://eds:eds@localhost:5432/eds

# Codex App Server for worker / inspector runtimes — a COMMAND LINE EDS
# spawns and speaks JSON-RPC to over its stdio (not an HTTP URL).
EDS_CODEX_APP_SERVER_URL=codex app-server

# M1 scope: the single fixed FastAPI template repository
# EDS_TEMPLATE_REPO_URL=https://github.com/example/fastapi-template.git

# Model credentials for the ADK Supervisor model.
# Google Gemini API key — https://aistudio.google.com/apikey
# (secret: only ever lives in gitignored .env, never committed)
GOOGLE_API_KEY=

# Vertex AI alternative to an API key (requires gcloud ADC; leave
# GOOGLE_API_KEY empty and uncomment):
#GOOGLE_GENAI_USE_VERTEXAI=true

# Supervisor model
EDS_LLM_MODEL=gemini-2.5-flash
